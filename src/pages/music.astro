---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const profileUrl = 'https://soundcloud.com/taylor-the-turtle';
/** Player URL from SoundCloud's oEmbed endpoint for the profile (user 19943444). The
 * profile has two tracks, so the list view fits in 300px. */
const playerUrl =
	'https://w.soundcloud.com/player/?url=https%3A%2F%2Fapi.soundcloud.com%2Fusers%2F19943444&color=%234a7c3f&show_artwork=true&visual=false';
---

<BaseLayout
	title="Taylor's Music | Taylor the Turtle"
	description="Sing along with Taylor the Turtle: songs that help children learn about their rights, feelings, and safety."
>
	<Header />
	<main id="main" class="paper">
		<div class="container-site py-14 lg:py-20">
			<h1 class="display-tight max-w-[20ch] text-4xl text-balance lg:text-5xl">Taylor's Music</h1>
			<p class="mt-5 max-w-[56ch] text-forest/80">
				Sing along with Taylor! Songs are a fun way to practise the teachings together, at home, in
				the car, or in the classroom.
			</p>

			<div id="player" class="mt-10 max-w-[48rem] rounded-3xl bg-white p-3">
				<div data-player-placeholder class="flex flex-col items-start gap-4 p-5">
					<p class="display-tight text-2xl">Listen on this page</p>
					<p class="max-w-[48ch] text-forest/80">
						The player is hosted by SoundCloud, which may set cookies once it loads.
					</p>
					<button
						type="button"
						data-player-load
						data-src={playerUrl}
						class="rounded-full bg-mustard px-6 py-3 font-extrabold text-[#3d3113] transition-colors hover:bg-[#e0a72e] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-forest"
					>
						Load the music player
					</button>
				</div>
			</div>
			<p class="mt-5">
				<a class="font-bold text-pine underline decoration-2 underline-offset-4 hover:text-forest" href={profileUrl}>
					Or listen on SoundCloud →
				</a>
			</p>
		</div>
	</main>
	<Footer />
</BaseLayout>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-player-load]');
	button?.addEventListener('click', () => {
		const iframe = document.createElement('iframe');
		iframe.src = `${button.dataset.src}&auto_play=true`;
		iframe.title = "Taylor the Turtle's songs on SoundCloud";
		iframe.allow = 'autoplay; encrypted-media';
		iframe.className = 'block h-[300px] w-full rounded-2xl border-0';
		document.querySelector('[data-player-placeholder]')?.replaceWith(iframe);
		iframe.focus();
	});
</script>
