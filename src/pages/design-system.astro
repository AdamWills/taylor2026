---
const colors = [
	{
		role: 'Primary',
		name: 'Taylor Green',
		hex: '#7DC050',
		className: 'swatch-green',
		text: 'light',
		copy: 'Primary buttons, key headings, brand moments. Pairs with white and Deep Forest.',
		tags: ['body on cream · FAIL', '28px+ · OK', 'white on green · OK'],
	},
	{
		role: 'Secondary',
		name: 'Shell Gold',
		hex: '#E8C547',
		className: 'swatch-gold',
		copy: 'Accent anchor. Secondary buttons, borders, focus rings, eyebrow labels.',
		tags: ['forest on gold · OK', 'white on gold · avoid'],
	},
	{
		role: 'Ink',
		name: 'Deep Forest',
		hex: '#243D14',
		className: 'swatch-forest',
		text: 'light',
		copy: 'Body text and high-contrast headings. Never pure black, which feels too harsh against the illustrations.',
		tags: ['on cream · AAA', 'on white · AAA'],
	},
	{
		role: 'Surface',
		name: 'Warm Cream',
		hex: '#FAF6EF',
		className: 'swatch-cream',
		copy: 'Default background. Lets characters breathe and gives the site its printed-book feel.',
		tags: ['forest text · AAA'],
	},
	{
		role: 'Link',
		name: 'Sky Blue',
		hex: '#2E7FD4',
		className: 'swatch-sky',
		text: 'light',
		copy: 'In-body links, informational highlights, gentle info state.',
		tags: ['on cream · OK'],
	},
	{
		role: 'Neutral',
		name: 'Wolf Gray',
		hex: '#8A8FA0',
		className: 'swatch-wolf',
		text: 'light',
		copy: 'Secondary text, dividers, UI chrome. Used sparingly.',
		tags: ['body · borderline', '18px+ · OK'],
	},
	{
		role: 'Character',
		name: 'Bear Brown',
		hex: '#A0561C',
		className: 'swatch-bear',
		text: 'light',
		copy: 'Illustration containers and decorative accents only. Not for body text.',
		tags: [],
	},
	{
		role: 'Character',
		name: 'Beaver Brown',
		hex: '#7B4B28',
		className: 'swatch-beaver',
		text: 'light',
		copy: 'Cooler illustration brown. Card borders and earthy moments.',
		tags: [],
	},
];

const principles = [
	['Picture book, not portal', "Each section is a spread with its own visual moment. There's always something to look at before something to read."],
	['Illustration leads', 'Characters anchor the page. Text is the explanation of something the visitor has already felt.'],
	['Warm, never clinical', "No red alerts, no navy palettes, no stock photography. If it'd fit on a public health notice, it doesn't belong here."],
];

const teachingCards = [
	['[ Taylor illustration ]', 'My body belongs to me.', "Children learn that they are in charge of their own bodies and that it's always okay to say no to touch that doesn't feel right."],
	['[ Taylor + laptop illustration ]', 'I have the right to be safe online.', 'The internet is part of everyday life. Taylor helps children understand what safety looks like in digital spaces too.'],
	['[ Taylor as officer / firefighter ]', 'I have the right to be cared for during emergencies.', 'First responders are helpers. This teaching gives children the language and confidence to reach out when they need support.'],
];

const spacing = [
	['--s-1', '4px', 4],
	['--s-2', '8px', 8],
	['--s-3', '12px', 12],
	['--s-4', '16px', 16],
	['--s-5', '24px', 24],
	['--s-6', '32px', 32],
	['--s-7', '48px', 48],
	['--s-8', '64px', 64],
	['--s-9', '96px', 96],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Nunito+Sans:wght@400;500;600;700&family=Fredoka:wght@400;500;600;700&family=Chewy&family=Grandstander:wght@500;600;700;800&family=Lilita+One&family=Comfortaa:wght@500;600;700&family=Patrick+Hand&family=Gaegu:wght@400;700&display=swap" rel="stylesheet" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Taylor the Turtle — Design System</title>
	</head>
	<body>
		<main class="page-shell">
			<header class="site-header">
				<div>
					<p class="hand kicker">a program of the Sexual Assault Centre of Brant</p>
					<h1>Taylor the Turtle<br /><span>Design System</span></h1>
					<p class="lede">A warm, approachable visual language for child safety education. Built for parents, educators, and children, in that reading order, but the opposite emotional order.</p>
				</div>
				<div class="meta">
					<strong>v0.2 · Astro draft</strong>
					taylorsrights.ca<br />
					Updated Apr 2026
				</div>
			</header>

			<section class="system-section">
				<p class="eyebrow">01 — Principles</p>
				<h2>Approachability over authority</h2>
				<p class="intro">Every decision answers one question: does this feel like an invitation, or an instruction? If it reads as the latter, we rework it.</p>
				<div class="grid three">
					{principles.map(([title, copy]) => (
						<article class="card">
							<h3>{title}</h3>
							<p>{copy}</p>
						</article>
					))}
				</div>
			</section>

			<section class="system-section">
				<p class="eyebrow">02 — Color</p>
				<h2>A palette drawn from the forest</h2>
				<p class="intro">Every color comes from the character illustrations. Use Taylor Green to assert the brand, Shell Gold to reward, Deep Forest to speak, and Warm Cream to breathe.</p>
				<div class="color-grid">
					{colors.map((color) => (
						<article class="color-card">
							<div class:list={['swatch', color.className, color.text === 'light' && 'light']}>{color.role}</div>
							<div class="color-copy">
								<strong>{color.name}</strong>
								<code>{color.hex}</code>
								<p>{color.copy}</p>
								{color.tags.length > 0 && (
									<div class="tags">
										{color.tags.map((tag) => <span class:list={['tag', tag.includes('FAIL') || tag.includes('avoid') || tag.includes('borderline') ? 'warn' : 'ok']}>{tag}</span>)}
									</div>
								)}
							</div>
						</article>
					))}
				</div>
				<article class="card gradient-card">
					<h3>Sanctioned gradient</h3>
					<div class="brand-gradient"></div>
					<p class="note">The only gradient permitted: Taylor Green → Shell Gold. It echoes Taylor's shell trim. All other gradients are off-limits.</p>
				</article>
			</section>

			<section class="system-section">
				<p class="eyebrow">03 — Typography</p>
				<h2>One expressive voice, one readable one</h2>
				<p class="intro">The display face sets the mood: warm, rounded, picture-book. Nunito Sans supports as body. Good Dog carries teaching statements and matches the printed colouring-sheet handwriting.</p>
				<div class="grid two">
					<article class="card type-card">
						<h3>Display — <span id="display-name">Quicksand</span></h3>
						<p class="note">Rounded, friendly terminals. Use for headings, labels, buttons, card titles.</p>
						<div class="type-row"><code>Hero<br />58/1.05 · 600</code><strong class="hero-type">Every child has rights.</strong></div>
						<div class="type-row"><code>H1<br />42/1.1 · 600</code><strong class="h1-type">A little turtle with a big message</strong></div>
						<div class="type-row"><code>H2<br />32/1.15 · 600</code><strong class="h2-type">Taylor's Teachings</strong></div>
						<div class="type-row"><code>H3<br />24/1.2 · 600</code><strong class="h3-type">For parents &amp; families</strong></div>
						<div class="type-row"><code>Button<br />16 · 600</code><strong class="button-type">Meet Taylor &amp; Friends →</strong></div>
						<div class="type-row"><code>Eyebrow<br />13 · 500</code><span class="eyebrow sample">A program of the Sexual Assault Centre of Brant</span></div>
					</article>
					<article class="card type-card">
						<h3>Body — Nunito Sans</h3>
						<p class="note">Humanist, warm, disappears into the content. 18px preferred, 16px minimum.</p>
						<div class="type-row"><code>Lead<br />20/1.55 · 400</code><span class="lead-type">Taylor and friends help children and the adults who love them talk about body safety.</span></div>
						<div class="type-row"><code>Body<br />17/1.55 · 400</code><span>Taylor's world is always safe to explore. Parents and educators can browse alongside children with confidence.</span></div>
						<div class="type-row"><code>Small<br />14/1.5 · 500</code><span class="small-type">We'll be in touch within a few days to find a time that works.</span></div>
						<div class="type-row"><code>Caption<br />13 · Wolf Gray</code><span class="caption">Taylor the Turtle is on the territory of the Haudenosaunee, Anishinaabe, and Neutral Nations.</span></div>
					</article>
				</div>
				<article class="card teaching-statement">
					<h3>Teaching statements — Good Dog</h3>
					<p class="note">Ethan Dunham's Good Dog, the hand-drawn face already used on the printed colouring sheets. Locked in for all rights declarations.</p>
					<div class="hand statement">I have the right to a safe body.</div>
				</article>
				<article class="cream-card reading-level">
					<h3>Reading level</h3>
					<p><strong>Children-facing copy:</strong> Grade 2-3. Short sentences, active verbs, no clinical language.</p>
					<p><strong>Parent/educator copy:</strong> Grade 6-8. Warm but assured; "talk about" not "educate."</p>
				</article>
			</section>

			<section class="system-section">
				<p class="eyebrow">04 — Space &amp; shape</p>
				<h2>Rounded everything, generous air</h2>
				<p class="intro">An 8pt spacing scale, generous radii that echo the illustrations' rounded lines, and soft lifting shadows that never look drop-pasted.</p>
				<div class="grid two">
					<article class="card">
						<h3>Spacing scale (8pt)</h3>
						{spacing.map(([name, value, width]) => (
							<div class="space-row">
								<code>{name}</code>
								<code>{value}</code>
								<span style={`width:${width}px`}></span>
							</div>
						))}
					</article>
					<article class="card">
						<h3>Radii</h3>
						<div class="radius-grid">
							<span style="border-radius:8px">8 · sm</span>
							<span style="border-radius:16px">16 · md</span>
							<span style="border-radius:24px">24 · lg</span>
							<span style="border-radius:32px">32 · xl</span>
							<span class="pill">pill</span>
						</div>
						<p class="note">Use 16-24px as the default. Pills only on buttons and small tags. Avoid sharp corners entirely.</p>
						<h3>Shadows</h3>
						<div class="shadow-row">
							<span class="soft">sm · resting</span>
							<span class="raised">md · raised</span>
							<span class="lifted">lift · on hover</span>
						</div>
						<p class="note">Shadows use Deep Forest at 6-12% opacity, a warm, earthy lift.</p>
					</article>
				</div>
			</section>

			<section class="system-section">
				<p class="eyebrow">05 — Components</p>
				<h2>Buttons, cards, links, forms</h2>
				<p class="intro">All interactive elements hit 44x44px minimum. No destructive styles: errors speak in Sky Blue, gently.</p>
				<article class="card">
					<h3>Buttons</h3>
					<div class="button-row">
						<a class="button primary" href="#">Meet Taylor &amp; Friends →</a>
						<a class="button secondary" href="#">Book a Visit</a>
						<a class="button outline" href="#">Learn more</a>
						<a class="button primary large" href="#">Request a visit →</a>
						<span class="button primary disabled">Disabled</span>
					</div>
					<p class="note">Primary = Taylor Green + white. Secondary = Shell Gold + Deep Forest. Hover: +1px lift + md shadow + slight lighten. Focus: 4px Shell Gold ring.</p>
				</article>
				<div class="grid two component-pair">
					<article class="card">
						<h3>Links</h3>
						<p>In-body: <a href="#">this is a Sky Blue link</a>, no underline at rest, underlined on hover.</p>
						<p>Navigation: <a class="nav-link" href="#">Deep Forest</a> at rest, <span class="green-text">Taylor Green</span> on hover and active.</p>
					</article>
					<article class="card">
						<h3>Top nav</h3>
						<nav class="nav-demo" aria-label="Demo navigation">
							<strong>Taylor 🐢</strong>
							<div>
								<a href="#">Meet Taylor</a>
								<a href="#">Teachings</a>
								<a href="#">Our Story</a>
								<a href="#">Events</a>
								<a class="button secondary small" href="#">Book a Visit</a>
							</div>
						</nav>
					</article>
				</div>
				<div class="teaching-cards">
					<h3>Teaching card <span>— the signature component</span></h3>
					<div class="grid three">
						{teachingCards.map(([image, title, copy]) => (
							<article class="teaching-card">
								<div class="image-placeholder">{image}</div>
								<h4>{title}</h4>
								<p>{copy}</p>
								<a href="#">Download the colouring sheet ↓</a>
							</article>
						))}
					</div>
					<p class="note">Warm Cream background, 2px Shell Gold border, 24px radius. Hover: translateY(-4px) + lift shadow. No scale transforms.</p>
				</div>
				<div class="form-block">
					<h3>Form — Book a Visit</h3>
					<form>
						<label>Your name <input type="text" placeholder="Alex Morgan" /></label>
						<label>School, centre, or group <input type="text" placeholder="Brantford Family Centre" /></label>
						<label>Age range of the group
							<select>
								<option>Ages 3-5</option>
								<option>Ages 5-8</option>
								<option>Mixed 3-8</option>
							</select>
						</label>
						<label>Anything we should know? <textarea rows="3" placeholder="Tell us about your group and what you're hoping Taylor can bring."></textarea></label>
						<p>We'll be in touch within a few days. Taylor's tours are always free.</p>
						<a class="button primary" href="#">Request a visit →</a>
					</form>
					<p class="note">Labels use the display face. Inputs get a Shell Gold focus ring. On mobile the submit is full-width.</p>
				</div>
			</section>

			<section class="system-section">
				<p class="eyebrow">06 — Illustration</p>
				<h2>Characters lead, words follow</h2>
				<p class="intro">The illustrations are the brand's most valuable asset. Stage them generously. Let them face into the content they sit beside.</p>
				<div class="grid two">
					<article class="illustration-card cream-card">
						<div class="character-placeholder">[ Taylor · gestures right → ]</div>
						<div>
							<h3>Gestures point into the copy</h3>
							<p>If Taylor is waving, place the text to the side Taylor is waving toward. Characters guide the eye and should never turn their backs on the content.</p>
						</div>
					</article>
					<article class="illustration-card green-panel">
						<div>
							<h3>Generous cream space</h3>
							<p>On a solid Taylor Green field, leave at least 32px of padding around every character edge. Never crop a character tight to another element.</p>
						</div>
						<div class="character-placeholder light">[ Taylor · full height ]</div>
					</article>
				</div>
				<article class="card">
					<h3>Background rules</h3>
					<div class="tags rules">
						<span class="tag ok">✓ Warm Cream surface</span>
						<span class="tag ok">✓ Solid Taylor Green field</span>
						<span class="tag ok">✓ Simple nature pattern</span>
						<span class="tag warn">✗ Photographic backgrounds</span>
						<span class="tag warn">✗ Complex textures</span>
						<span class="tag warn">✗ Characters below 180px web</span>
						<span class="tag warn">✗ Colouring-sheet B&amp;W on web</span>
					</div>
				</article>
				<article class="card">
					<h3>When to use the group illustration</h3>
					<p>The ensemble is a celebration piece. Homepage hero, Meet the Friends page header, or a section break between major content areas. Don't overuse it; Taylor should remain the most frequently appearing character.</p>
				</article>
			</section>

			<section class="system-section">
				<p class="eyebrow">07 — Voice</p>
				<h2>Friendly, curious, quietly confident</h2>
				<p class="intro">Taylor doesn't lecture. Taylor explores. If a sentence would make an adult anxious on first read, rewrite it.</p>
				<div class="grid two">
					<article class="voice do">
						<h3>✓ Do write like this</h3>
						<ul>
							<li>"Taylor helps kids talk about body safety."</li>
							<li>"Your family is part of Taylor's world."</li>
							<li>"It's always okay to say no."</li>
							<li>"Taylor is coming to Brantford."</li>
							<li>"We'll be in touch within a few days."</li>
						</ul>
					</article>
					<article class="voice dont">
						<h3>✗ Don't write like this</h3>
						<ul>
							<li>"Educate your child on identifying risk."</li>
							<li>"Caregivers must intervene in unsafe situations."</li>
							<li>"Prevention of child sexual abuse."</li>
							<li>"Statistics show 1 in 3 children..."</li>
							<li>"Submit your request for processing."</li>
						</ul>
					</article>
				</div>
			</section>

			<section class="system-section">
				<p class="eyebrow">08 — Motion</p>
				<h2>Organic, unhurried, rewarding</h2>
				<p class="intro">Characters drift in the way they'd walk into frame in a picture book, never the way a UI component snaps in.</p>
				<div class="grid two">
					<article class="card">
						<h3>Page-load entrance</h3>
						<button id="motion-demo" class="motion-demo" type="button">
							<span id="motion-puck">Taylor</span>
							<small>click to replay</small>
						</button>
						<code>translateY(20px → 0), opacity(0 → 1), 600ms ease-out, stagger 150ms</code>
					</article>
					<article class="card">
						<h3>Rules of thumb</h3>
						<ul>
							<li>No looping character animations. The illustrations are expressive at rest.</li>
							<li>No scale transforms on character images. They distort proportions.</li>
							<li>Card hover: translateY(-4px) + deepened shadow only.</li>
							<li>Respect prefers-reduced-motion: disable entrances, keep hovers.</li>
						</ul>
					</article>
				</div>
			</section>

			<section class="system-section">
				<p class="eyebrow">09 — Accessibility</p>
				<h2>Core to the mission, not a checklist</h2>
				<p class="intro">The audience includes children with varied reading abilities and parents in high-distraction environments. Accessibility is the whole point.</p>
				<div class="grid three">
					<article class="card">
						<h3>Contrast</h3>
						<p>Deep Forest on Warm Cream clears AAA at all sizes. Taylor Green only carries text at 28px+ or on dark fields. Wolf Gray only at 18px+.</p>
					</article>
					<article class="card">
						<h3>Alt text</h3>
						<p>Every illustration names the character and describes the action. "Taylor in a firefighter's uniform, waving to a friend."</p>
					</article>
					<article class="card">
						<h3>Touch targets</h3>
						<p>Minimum 44x44px, with 8px spacing between adjacent targets. Mobile-first validation at 375px width.</p>
					</article>
				</div>
			</section>

			<footer>Taylor the Turtle Design System · v0.2 · Astro · built for taylorsrights.ca</footer>
		</main>

		<div id="tweaks" class="tweaks" hidden>
			<h2>Tweaks</h2>
			<label>Display font
				<select id="tk-display">
					<option value="Quicksand">Quicksand (current)</option>
					<option value="Fredoka">Fredoka</option>
					<option value="Chewy">Chewy</option>
					<option value="Grandstander">Grandstander</option>
					<option value="Lilita One">Lilita One</option>
					<option value="Comfortaa">Comfortaa</option>
					<option value="Patrick Hand">Patrick Hand</option>
					<option value="Gaegu">Gaegu</option>
					<option value="Good Dog">Good Dog</option>
				</select>
			</label>
			<label>Body font
				<select id="tk-body">
					<option value="Nunito Sans">Nunito Sans</option>
					<option value="Jost">Jost</option>
					<option value="Nunito">Nunito</option>
				</select>
			</label>
			<label>Taylor Green <input type="color" id="tk-green" /></label>
			<label>Shell Gold <input type="color" id="tk-gold" /></label>
			<label>Warm Cream <input type="color" id="tk-cream" /></label>
			<p>Good Dog is locked for teaching statements regardless.</p>
		</div>

		<script is:inline>
			const defaults = {
				displayFont: 'Quicksand',
				bodyFont: 'Nunito Sans',
				taylorGreen: '#7DC050',
				shellGold: '#E8C547',
				warmCream: '#FAF6EF',
			};
			const state = { ...defaults };
			const loaded = new Set(['Fredoka', 'Nunito Sans', 'Quicksand', 'Chewy', 'Grandstander', 'Lilita One', 'Comfortaa', 'Patrick Hand', 'Gaegu', 'Good Dog']);

			function loadFont(family) {
				if (loaded.has(family)) return;
				const link = document.createElement('link');
				link.rel = 'stylesheet';
				link.href = 'https://fonts.googleapis.com/css2?family=' + encodeURIComponent(family) + ':wght@400;500;600;700&display=swap';
				document.head.appendChild(link);
				loaded.add(family);
			}

			function hexToRgb(hex) {
				const normalized = hex.replace('#', '');
				return [parseInt(normalized.slice(0, 2), 16), parseInt(normalized.slice(2, 4), 16), parseInt(normalized.slice(4, 6), 16)];
			}

			function rgbToHex(r, g, b) {
				return '#' + [r, g, b].map((value) => Math.max(0, Math.min(255, Math.round(value))).toString(16).padStart(2, '0')).join('');
			}

			function shade(hex, pct) {
				const [r, g, b] = hexToRgb(hex);
				const factor = 1 + pct / 100;
				return rgbToHex(r * factor, g * factor, b * factor);
			}

			function tint(hex, amount) {
				const [r, g, b] = hexToRgb(hex);
				return rgbToHex(r + (255 - r) * amount, g + (255 - g) * amount, b + (255 - b) * amount);
			}

			function applyTweaks() {
				loadFont(state.displayFont);
				loadFont(state.bodyFont);
				const root = document.documentElement;
				root.style.setProperty('--font-display', `'${state.displayFont}', system-ui, sans-serif`);
				root.style.setProperty('--font-body', `'${state.bodyFont}', system-ui, sans-serif`);
				root.style.setProperty('--green', state.taylorGreen);
				root.style.setProperty('--green-dark', shade(state.taylorGreen, -14));
				root.style.setProperty('--green-tint', tint(state.taylorGreen, 0.82));
				root.style.setProperty('--gold', state.shellGold);
				root.style.setProperty('--cream', state.warmCream);

				document.getElementById('display-name').textContent = state.displayFont;
				document.getElementById('tk-display').value = state.displayFont;
				document.getElementById('tk-body').value = state.bodyFont;
				document.getElementById('tk-green').value = state.taylorGreen;
				document.getElementById('tk-gold').value = state.shellGold;
				document.getElementById('tk-cream').value = state.warmCream;
			}

			function send(edits) {
				Object.assign(state, edits);
				applyTweaks();
				try {
					window.parent.postMessage({ type: '__edit_mode_set_keys', edits }, '*');
				} catch {}
			}

			document.getElementById('tk-display').addEventListener('change', (event) => send({ displayFont: event.target.value }));
			document.getElementById('tk-body').addEventListener('change', (event) => send({ bodyFont: event.target.value }));
			document.getElementById('tk-green').addEventListener('input', (event) => send({ taylorGreen: event.target.value }));
			document.getElementById('tk-gold').addEventListener('input', (event) => send({ shellGold: event.target.value }));
			document.getElementById('tk-cream').addEventListener('input', (event) => send({ warmCream: event.target.value }));

			window.addEventListener('message', (event) => {
				const data = event.data || {};
				if (data.type === '__activate_edit_mode') document.getElementById('tweaks').hidden = false;
				if (data.type === '__deactivate_edit_mode') document.getElementById('tweaks').hidden = true;
			});

			try {
				window.parent.postMessage({ type: '__edit_mode_available' }, '*');
			} catch {}

			const motionDemo = document.getElementById('motion-demo');
			const puck = document.getElementById('motion-puck');
			function play() {
				puck.classList.remove('drift');
				void puck.offsetWidth;
				puck.classList.add('drift');
			}
			motionDemo.addEventListener('click', play);
			requestAnimationFrame(play);
			applyTweaks();
		</script>
	</body>
</html>

