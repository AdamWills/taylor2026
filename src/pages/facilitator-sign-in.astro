---
// The password form for the facilitator gate. src/worker.ts serves this page in
// place of anything under /facilitators until the visitor has a valid cookie,
// pointing the form at the path they asked for and filling in #gate-message
// after a wrong password. It holds nothing secret, so it is fine that it is
// also reachable at its own URL.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Facilitator Sign-in | Taylor the Turtle" noindex>
	<Header />
	<main id="main" class="paper">
		<div class="container-site py-20 lg:py-28">
			<p class="text-[13px] font-extrabold tracking-[0.12em] text-forest/80 uppercase">For facilitators</p>
			<h1 class="display-tight mt-3 max-w-[20ch] text-4xl text-balance lg:text-5xl">Facilitator sign-in</h1>
			<p class="mt-5 max-w-[52ch] text-forest/80">
				Program materials, session guides, and refreshers are for trained Taylor the Turtle facilitators.
				Enter the facilitator password you were given at training.
			</p>

			<form method="post" action="/facilitators/" class="mt-8 max-w-md">
				<!-- Lets password managers file the shared password under one name. -->
				<input type="text" name="username" value="facilitator" autocomplete="username" hidden />
				<label for="password" class="block font-bold">Password</label>
				<input
					id="password"
					name="password"
					type="password"
					autocomplete="current-password"
					autocapitalize="off"
					spellcheck="false"
					required
					aria-describedby="gate-message"
					class="mt-2 block w-full rounded-2xl border-2 border-pine/60 bg-milk px-4 py-3 text-forest focus:border-pine focus:outline-2 focus:outline-offset-2 focus:outline-mustard"
				/>
				<p id="gate-message" role="alert" class="mt-3 rounded-xl bg-plum-tint px-4 py-3 font-bold text-plum" hidden></p>
				<Button class="mt-6">Sign in</Button>
			</form>

			<p class="mt-10 max-w-[52ch] text-forest/80">
				Lost the password? Contact SAC Brant at
				<a class="font-bold text-plum underline decoration-2 underline-offset-4" href="tel:+15197511164">519.751.1164</a>.
			</p>
		</div>
	</main>
	<Footer />
</BaseLayout>
