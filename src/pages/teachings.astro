---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { themes, themesIntro } from '../data/themes';
import { teachings } from '../data/teachings';
---

<BaseLayout
	title="Taylor's Teachings | Taylor the Turtle"
	description="Taylor's ten teachings and the eight themes that connect them: simple, powerful rights every child has."
>
	<Header />
	<main id="main" class="paper">
		<div class="container-site py-14 lg:py-20">
			<h1 class="display-tight max-w-[20ch] text-4xl text-balance lg:text-5xl">Taylor's Teachings</h1>
			<p class="mt-5 max-w-[56ch] text-forest/80">
				Ten simple rights, each one a conversation starter, starting with the most important
				one of all: my body belongs to me.
			</p>

			<section id="themes" class="mt-14 scroll-mt-8" aria-labelledby="themes-heading">
				<h2 id="themes-heading" class="display-tight text-3xl text-balance lg:text-4xl">Overarching themes</h2>
				<p class="mt-4 max-w-[60ch] text-forest/80">{themesIntro}</p>
				<ol class="mt-10 grid gap-5 sm:grid-cols-2" role="list">
					{themes.map(({ title, text }, index) => (
						<li class="reveal flex gap-4 rounded-3xl bg-white p-6" style={`--reveal-delay: ${(index % 2) * 80}ms`}>
							<span
								class="display-tight flex size-11 shrink-0 items-center justify-center rounded-full bg-mustard text-xl text-[#3d3113]"
								aria-hidden="true"
							>
								{index + 1}
							</span>
							<div>
								<h3 class="display-tight text-xl">{title}</h3>
								<p class="mt-2 text-[16px] text-forest/80 text-pretty">{text}</p>
							</div>
						</li>
					))}
				</ol>
			</section>

			<section id="rights" class="mt-16 scroll-mt-8" aria-labelledby="rights-heading">
				<h2 id="rights-heading" class="display-tight text-3xl text-balance lg:text-4xl">The ten teachings</h2>
				<p class="mt-4 max-w-[60ch] text-forest/80">
					Each teaching has an illustration to talk through together and a free colouring sheet to
					print at home or in the classroom.
				</p>
				{/* Teaching 1 is the core teaching, so it spans the row; the other nine fill a 3×3 grid. */}
				<ol class="mt-10 grid gap-6 md:grid-cols-3" role="list">
					{teachings.map(({ slug, title, lineArt, pdf }, index) => {
						const core = index === 0;
						return (
							<li
								id={slug}
								class:list={['reveal flex scroll-mt-8 flex-col rounded-3xl bg-white p-5', core && 'md:col-span-3 md:flex-row md:items-center md:gap-8']}
								style={`--reveal-delay: ${core ? 0 : ((index - 1) % 3) * 80}ms`}
							>
								<div
									class:list={[
										'flex items-center justify-center overflow-hidden rounded-2xl bg-sage-tile p-6',
										core ? 'aspect-[4/5] md:aspect-square md:w-80 md:shrink-0' : 'aspect-[4/5]',
									]}
								>
									<Image
										src={lineArt}
										alt=""
										class="max-h-full max-w-full object-contain"
										widths={[320, 640]}
										sizes={core ? '(min-width: 768px) 320px, 80vw' : '(min-width: 1024px) 300px, (min-width: 768px) 30vw, 80vw'}
									/>
								</div>
								<div class:list={['flex flex-1 flex-col', core && 'md:py-4']}>
									<p class="mt-4 text-[13px] font-extrabold tracking-[0.1em] text-pine uppercase md:mt-4">
										Teaching {index + 1}{core && ' · The core teaching'}
									</p>
									<h3 class:list={['display-tight mt-1 text-balance', core ? 'text-3xl lg:text-4xl' : 'text-xl']}>{title}</h3>
									{core && (
										<p class="mt-3 max-w-[48ch] text-forest/80 text-pretty">
											Every one of Taylor's teachings begins here: children learn that their body is their
											own, and that they deserve safety, care, and respect.
										</p>
									)}
									<a
										href={pdf}
										download
										class="mt-auto self-start pt-4 font-bold text-forest underline decoration-mustard decoration-2 underline-offset-4 hover:decoration-forest"
									>
										Download colouring sheet <span class="sr-only">for “{title}”</span> (PDF)
									</a>
								</div>
							</li>
						);
					})}
				</ol>
			</section>
		</div>
	</main>
	<Footer />
</BaseLayout>
