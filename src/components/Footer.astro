---
import { Image } from 'astro:assets';
import { SHOW_ARTICLES, SHOW_EVENTS, SHOW_FACILITATORS } from '../data/sections';
import sacBrant from '../assets/logos/sac-brant.png';
import ganohkwasra from '../assets/logos/ganohkwasra.png';

const columns = [
	{
		heading: 'Learn',
		links: [
			{ href: '/teachings', label: "Taylor's Teachings" },
			{ href: '/colouring', label: 'Colouring Pages' },
			{ href: '/music', label: "Taylor's Music" },
		],
	},
	{
		heading: 'About',
		links: [
			{ href: '/our-story', label: 'Our Story' },
			{ href: '/team', label: 'Team' },
			{ href: '/photos', label: 'Photo Album' },
			...(SHOW_ARTICLES ? [{ href: '/articles', label: 'Articles' }] : []),
		],
	},
	{
		heading: 'Connect',
		links: [
			...(SHOW_EVENTS ? [{ href: '/events', label: 'Events' }] : []),
			{ href: '/book-a-visit', label: 'Book a Visit' },
			...(SHOW_FACILITATORS ? [{ href: '/facilitators', label: 'Facilitator Sign-in' }] : []),
		],
	},
];
---

<footer class="bg-forest text-mist">
	<div class="container-site grid gap-10 py-12 text-[15px] md:grid-cols-[13fr_10fr_10fr_10fr]">
		<div>
			<p class="display-tight text-lg text-milk">Taylor the Turtle.</p>
			<p class="mt-3 max-w-[36ch]">
				A collaboration led by the Sexual Assault Centre of Brant and Ganohkwasra Family Assault
				Support Services.
			</p>
			<p class="mt-4 flex gap-4 font-bold text-milk">
				<a class="hover:text-mustard" href="https://www.facebook.com/p/Taylor-the-Turtle-100064712075040/">Facebook</a>
				<a class="hover:text-mustard" href="https://www.instagram.com/taylorsrights.ca">Instagram</a>
				<a class="hover:text-mustard" href="https://soundcloud.com/taylor-the-turtle">SoundCloud</a>
			</p>
			<ul class="mt-6 flex gap-3" role="list" aria-label="Lead partners">
				<li>
					<a class="block rounded-2xl bg-white p-2 hover:ring-2 hover:ring-mustard" href="https://sacbrant.ca/">
						<Image src={sacBrant} alt="Sexual Assault Centre of Brant" class="size-20 object-contain" width={160} height={160} />
					</a>
				</li>
				<li>
					<a class="block rounded-2xl bg-white p-2 hover:ring-2 hover:ring-mustard" href="https://www.ganohkwasra.com/">
						<Image src={ganohkwasra} alt="Ganohkwasra Family Assault Support Services" class="size-20 object-contain" width={160} height={160} />
					</a>
				</li>
			</ul>
		</div>
		{columns.map(({ heading, links }) => (
			<nav aria-label={heading}>
				<h2 class="text-[12px] font-extrabold tracking-[0.1em] text-milk uppercase">{heading}</h2>
				<ul class="mt-3 space-y-2" role="list">
					{links.map(({ href, label }) => (
						<li><a class="hover:text-milk" href={href}>{label}</a></li>
					))}
				</ul>
			</nav>
		))}
	</div>
	<div class="container-site border-t border-milk/15 py-5 text-[14px]">
		<p>519.751.1164 · Brantford, Brant County &amp; Six Nations</p>
	</div>
</footer>
