---
import { Image } from 'astro:assets';
import { initials, type Person } from '../data/team';

interface Props {
	person: Person;
	index?: number;
}

const { person, index = 0 } = Astro.props;
const { name, role, headshot, bio = [], tale, dailyReminder } = person;
---

<article class="reveal flex flex-col gap-5 rounded-3xl bg-white p-6 sm:flex-row sm:p-8" style={`--reveal-delay: ${(index % 2) * 80}ms`}>
	{headshot ? (
		<Image
			src={headshot}
			alt=""
			class="size-28 shrink-0 rounded-full border-[3px] border-sage-tile object-cover"
			width={224}
			height={224}
		/>
	) : (
		<span
			class="display-tight flex size-28 shrink-0 items-center justify-center rounded-full bg-sage-tile text-2xl text-forest"
			aria-hidden="true"
		>
			{initials(name)}
		</span>
	)}
	<div class="min-w-0">
		<h3 class="display-tight text-2xl">{name}</h3>
		<p class="mt-1 text-[13px] font-extrabold tracking-[0.08em] text-pine uppercase">{role}</p>
		{bio.length > 0 && (
			<div class="mt-4 space-y-3 text-[16px] text-forest/85 text-pretty">
				{bio.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		)}
		{tale && (
			<aside class="mt-5 rounded-2xl bg-sage-tile p-5">
				<p class="text-[12px] font-extrabold tracking-[0.1em] text-pine uppercase">Tales with Taylor</p>
				<p class="mt-2 text-[16px] text-forest/85 text-pretty">{tale}</p>
			</aside>
		)}
		{dailyReminder && (
			<blockquote class="mt-5 border-l-4 border-mustard pl-4">
				<p class="text-[12px] font-extrabold tracking-[0.1em] text-pine uppercase">Daily reminder</p>
				<p class="display-tight mt-1 text-lg text-pretty">{dailyReminder}</p>
			</blockquote>
		)}
	</div>
</article>
