---
import Button from './Button.astro';

const links = [
	['Meet Taylor & Friends', '#meet-friends'],
	["Taylor's Teachings", '#teachings'],
	['Our Story', '#about'],
	['Events', '#stay-connected'],
	['Resources', '#teachings'],
];
---

<header class="fixed left-1/2 top-4 z-10 flex w-[calc(100%-40px)] max-w-[1180px] -translate-x-1/2 items-center justify-between gap-5 rounded-full border border-warm-cream-deep/90 bg-warm-cream/90 px-3 py-2 pl-5 shadow-soft backdrop-blur-xl max-[560px]:absolute max-[560px]:flex-col max-[560px]:rounded-[28px] max-[560px]:p-3.5">
	<a class="whitespace-nowrap font-display text-[21px] font-extrabold text-taylor-green-dark hover:no-underline" href="/" aria-label="Taylor the Turtle home">Taylor the Turtle</a>
	<nav class="flex items-center gap-4 max-[1040px]:hidden" aria-label="Primary navigation">
		{links.map(([label, href]) => <a class="whitespace-nowrap font-display text-sm font-semibold text-deep-forest transition hover:text-taylor-green-dark hover:no-underline" href={href}>{label}</a>)}
	</nav>
	<div class="flex items-center gap-3 max-[560px]:w-full">
		<a class="font-display text-[13px] font-bold text-wolf-gray hover:no-underline max-[1040px]:hidden" href="#" aria-label="Instagram">Instagram</a>
		<a class="font-display text-[13px] font-bold text-wolf-gray hover:no-underline max-[1040px]:hidden" href="#" aria-label="Facebook">Facebook</a>
		<Button class="min-h-[42px] px-4 py-2.5 text-sm max-[560px]:w-full" href="#book-visit" variant="secondary">Book a Visit</Button>
	</div>
</header>
