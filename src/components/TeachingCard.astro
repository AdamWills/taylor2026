---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import IllustrationPlaceholder from './IllustrationPlaceholder.astro';

interface Props {
	image?: ImageMetadata;
	illustration: string;
	title: string;
	description: string;
	href?: string;
}

const { image, illustration, title, description, href = '#' } = Astro.props;
---

<article class="flex flex-col gap-4 rounded-[28px] border-2 border-shell-gold bg-warm-cream p-6 transition hover:-translate-y-1 hover:shadow-lift">
	{image
		? <div class="aspect-[3/4] max-h-64 rounded-[18px] bg-[linear-gradient(135deg,#eaf4de,#f7e8a8)]">
				<Image src={image} alt={illustration} class="size-full object-contain" widths={[400, 800]} sizes="(min-width: 1024px) 400px, 100vw" />
			</div>
		: <IllustrationPlaceholder kind="wide" label={illustration} />
	}
	<h3 class="font-display text-[clamp(26px,3vw,32px)] font-semibold tracking-[-0.03em] text-taylor-green-dark text-balance">{title}</h3>
	<p class="text-[15px] text-deep-forest/80">{description}</p>
	<a class="mt-auto font-display text-[15px] font-bold text-sky-blue" href={href}>Download the colouring sheet ↓</a>
</article>
