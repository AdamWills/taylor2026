---
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import { team } from '../../data/team';

const initials = (name: string) =>
	name
		.replace(/^Dr\.\s+/, '')
		.split(' ')
		.map((part) => part[0])
		.slice(0, 2)
		.join('');
---

<section class="bg-pine">
	<div class="container-site py-14 text-center lg:py-20">
		<h2 class="display-tight text-3xl text-milk lg:text-4xl">The people behind the turtle</h2>
		<p class="mx-auto mt-3 max-w-[56ch] text-[15.5px] text-milk">
			A family of creators, counsellors, researchers, and community builders across SAC Brant,
			Ganohkwasra, and Wilfrid Laurier University.
		</p>
		<ul class="mx-auto mt-9 flex max-w-[680px] flex-wrap justify-center gap-x-4 gap-y-6" role="list">
			{team.map(({ name, role, headshot }, index) => (
				<li class="group relative hover:z-10">
					{headshot ? (
						<Image
							src={headshot}
							alt={`${name}, ${role}`}
							class:list={[
								'size-24 rounded-full border-[3px] border-milk object-cover transition duration-200 ease-out group-hover:-translate-y-1 group-hover:rotate-0 group-hover:scale-110',
								index % 2 === 0 ? '-rotate-3' : 'rotate-3',
							]}
							width={192}
							height={192}
						/>
					) : (
						<span
							class:list={[
								'display-tight flex size-24 items-center justify-center rounded-full border-[3px] border-milk bg-sage-tile text-xl text-forest transition duration-200 ease-out group-hover:-translate-y-1 group-hover:rotate-0 group-hover:scale-110',
								index % 2 === 0 ? '-rotate-3' : 'rotate-3',
							]}
							aria-hidden="true"
						>
							{initials(name)}
						</span>
					)}
					{!headshot && <span class="sr-only">{name}, {role}</span>}
					<span
						class="pointer-events-none absolute top-full left-1/2 z-10 mt-1.5 -translate-x-1/2 rounded-full bg-milk px-3 py-1 text-[12px] font-bold whitespace-nowrap text-forest opacity-0 transition group-hover:opacity-100"
						aria-hidden="true"
					>
						{name}
					</span>
				</li>
			))}
		</ul>
		<Button class="mt-9" href="/team" variant="mustard">Meet the team</Button>
	</div>
</section>
