---
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import Squiggle from '../Squiggle.astro';
import group from '../../assets/MyBodyBelongsToMe.png';
---

<section class="paper">
	<div class="container-site pt-10 pb-10 text-center lg:pt-16 lg:pb-14">
		<h1 class="display-tight mx-auto max-w-[18ch] text-[clamp(2.5rem,5.5vw,3.8rem)] leading-[1.05] text-balance">
			Big feelings, little turtle, and the
			<span class="relative sm:whitespace-nowrap text-ochre">
				rights every child has
				<Squiggle class="absolute -bottom-2.5 left-0 h-3 w-full max-sm:hidden" />
			</span>
		</h1>
		<p class="mx-auto mt-6 max-w-[54ch] text-forest/80 text-pretty">
			Taylor the Turtle helps caring adults teach children aged 18 months to six about body
			rights, feelings, and safety — without fear-based lessons. Recognized as a provincial
			best practice.
		</p>
		<div class="mt-7 flex flex-wrap justify-center gap-3">
			<Button href="/teachings">Explore Taylor's Teachings</Button>
			<Button href="/book-a-visit" variant="secondary">Book a Visit</Button>
		</div>
		<Image
			src={group}
			alt="Taylor the Turtle waving, surrounded by friends: Bear, Wolf, Deer, Eagle, Beaver, and Blue Jay"
			class="mx-auto mt-9 w-full max-w-[880px]"
			widths={[480, 760, 1120, 1760]}
			sizes="(min-width: 1024px) 880px, 92vw"
			loading="eager"
		/>
	</div>
</section>
