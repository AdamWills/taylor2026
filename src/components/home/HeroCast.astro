---
import { Image } from 'astro:assets';
import bear from '../../assets/cast/bear.png';
import beaver from '../../assets/cast/beaver.png';
import deer from '../../assets/cast/deer.png';
import eagle from '../../assets/cast/eagle.png';
import jay from '../../assets/cast/jay.png';
import wolf from '../../assets/cast/wolf.png';
import taylor from '../../assets/cast/taylor-skate.png';

/* Positions/sizes tuned against the original group illustration (see the
   composition mocks in the whimsy spec history). left/width are % of the stage;
   enter staggers the curtain call. */
const friends = [
	{ src: wolf, left: 4, width: 33.0, z: 1, enter: 0 },
	{ src: deer, left: 49, width: 23.9, z: 1, enter: 100 },
	{ src: bear, left: 22, width: 29.2, z: 2, enter: 200 },
	{ src: eagle, left: 66, width: 33.9, z: 2, enter: 300 },
	{ src: beaver, left: 0, width: 26.1, z: 3, enter: 400 },
	{ src: jay, left: 65, width: 15.8, z: 3, enter: 500 },
];
---

<div
	class="relative mx-auto mt-9 aspect-[2.03/1] w-full max-w-[880px]"
	role="img"
	aria-label="Taylor the Turtle rolls in on a skateboard, waving, joined by friends Bear, Wolf, Deer, Eagle, Beaver, and Blue Jay"
>
	{
		friends.map(({ src, left, width, z, enter }) => (
			<div class="cast-slot" style={`left:${left}%;width:${width}%;z-index:${z};--enter:${enter}ms`}>
				<Image src={src} alt="" widths={[240, 480]} sizes={`${Math.round((880 * width) / 100)}px`} loading="eager" />
			</div>
		))
	}
	<div class="cast-slot cast-taylor" style="left:40%;width:23%;z-index:4">
		<Image src={taylor} alt="" widths={[240, 480]} sizes="202px" loading="eager" />
	</div>
</div>
