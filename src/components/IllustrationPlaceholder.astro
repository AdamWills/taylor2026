---
interface Props {
	label: string;
	kind?: 'group' | 'single' | 'wide' | 'friend';
	class?: string;
}

const { label, kind = 'single', class: className = '' } = Astro.props;
---

<div
	class:list={[
		'illustration-placeholder relative flex items-center justify-center rounded-[28px] border-[1.5px] border-dashed p-6 text-center font-mono text-[13px] text-deep-forest/70',
		'bg-[repeating-linear-gradient(135deg,rgba(255,255,255,0.42)_0_10px,rgba(255,255,255,0.18)_10px_20px),linear-gradient(135deg,#eaf4de,#f7e8a8)]',
		'before:absolute before:left-1/2 before:top-1/2 before:h-[76%] before:w-[76%] before:-translate-x-1/2 before:-translate-y-1/2 before:rounded-full before:bg-[radial-gradient(circle,rgba(125,192,80,0.28),transparent_62%)] before:content-[\'\']',
		kind === 'single' && 'min-h-[260px] border-deep-forest/25',
		kind === 'wide' && 'min-h-[220px] aspect-[16/10] border-deep-forest/25',
		kind === 'group' && 'min-h-[420px] aspect-[1/0.86] border-white/45 text-white before:bg-[radial-gradient(circle,rgba(255,255,255,0.22),transparent_62%)]',
		kind === 'friend' && 'min-h-[120px] aspect-square border-white/50 text-white before:bg-[radial-gradient(circle,rgba(255,255,255,0.22),transparent_62%)]',
		className,
	]}
	aria-label={label}
	role="img"
>
	<span class="relative z-[1]">{label}</span>
</div>
