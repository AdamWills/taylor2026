---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/nunito-sans';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	/** Social share image, relative to the site root or absolute. */
	image?: string;
	imageAlt?: string;
}

const {
	title,
	description = 'Taylor the Turtle helps caring adults teach children about body rights, feelings, and safety. A community program of SAC Brant and Ganohkwasra.',
	image = '/og-default.png',
	imageAlt = 'Taylor the Turtle and friends: My body belongs to me!',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Taylor the Turtle" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:locale" content="en_CA" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-forest focus:px-5 focus:py-2.5 focus:font-bold focus:text-milk"
		>
			Skip to content
		</a>
		<slot />
		<script>
			const revealEls = document.querySelectorAll('.reveal');
			if ('IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-revealed');
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
				);
				revealEls.forEach((el) => io.observe(el));
			} else {
				revealEls.forEach((el) => el.classList.add('is-revealed'));
			}
		</script>
	</body>
</html>
